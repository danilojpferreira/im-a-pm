@@ -0,0 +1,39 @@
+package com.eeze.video.application.handlers;
+
+import java.util.UUID;
+
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.data.crossstore.ChangeSetPersister.NotFoundException;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Component;
+
+import com.eeze.video.application.dtos.responses.PublishVideoResponse;
+import com.eeze.video.application.exceptions.ApplicationException;
+import com.eeze.video.domain.entities.video.Video;
+import com.eeze.video.domain.services.VideoService.VideoService;
+
+/**
+ * Handler for moving a published video back to draft.
+ */
+@Component
+public class UnpublishVideoHandler {
+
+    @Autowired
+    private VideoService videoService;
+
+    public PublishVideoResponse execute(UUID id) throws ApplicationException {
+        try {
+            Video video = this.videoService.unpublish(id);
+            return new PublishVideoResponse(video);
+        } catch (Exception e) {
+            if (e instanceof NotFoundException) {
+                throw new ApplicationException(HttpStatus.NOT_FOUND, "Video not found", e);
+            }
+            if (e instanceof IllegalStateException) {
+                throw new ApplicationException(HttpStatus.BAD_REQUEST, e.getMessage(), e);
+            }
+            throw new ApplicationException(
+                    HttpStatus.INTERNAL_SERVER_ERROR, "An error occurred while unpublishing the video", e);
+        }
+    }
+}
