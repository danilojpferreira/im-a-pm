@@ -213,4 +213,21 @@ public class VideoService {
         // Return the updated video entity
         return video;
     }
+
+    /**
+     * Moves a published video back to DRAFT so viewers can no longer see it.
+     *
+     * @param id the UUID of the video to unpublish
+     * @return the updated Video entity
+     * @throws NotFoundException     if the video does not exist
+     * @throws IllegalStateException if the video is not published
+     */
+    public Video unpublish(UUID id) throws NotFoundException, IllegalStateException {
+        Video video = this.findOne(id);
+        if (video.getStatus() != Status.PUBLISHED) {
+            throw new IllegalStateException("Only published videos can be unpublished");
+        }
+        video.setStatus(Status.DRAFT);
+        return this.videoRepository.save(video);
+    }
 }
